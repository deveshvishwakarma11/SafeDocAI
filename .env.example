# SafeDocAI is fully local. No cloud API keys exist or are needed.

# Ollama (loopback only). Document data never leaves this machine.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# LLM answers for open questions are ON when Ollama is running.
# Every LLM answer is verified against the retrieved document text before it is
# shown; if it cannot be verified the user sees the document's own words.
# Set to "0" to turn the model off completely (retrieval + exact fields only).
# OLLAMA_SYNTHESIS="0"

# Keep the laptop responsive while the model generates.
# Default: half of your CPU cores.
# OLLAMA_NUM_THREAD=2

# Max time for one generation, in ms (first call may load the model). Default 60000.
# OLLAMA_TIMEOUT_MS=60000

# Server binds to loopback by default. Do not change unless you know why.
# HOST="127.0.0.1"
# PORT=3000

# OCR: after the normal pass, a poor result (very little readable text) gets
# one extra attempt in colour. 0 = never (fastest uploads), 1 = default.
# OCR_RESCUE=1
